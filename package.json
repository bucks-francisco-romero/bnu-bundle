{
  "name": "@bnuni/bnu-bundle",
  "version": "5.0.2",
  "description": "A collection of front end files to kickstart projects",
  "main": "js/index.js",
  "scripts": {
    "format:js": "node scripts/format.js ./node_modules './js/**/*.js'",
    "format:scss": "node scripts/format.js ./node_modules './sass/**/*.scss'",
    "build": "  npm-run-all build:* build:** minify:* minify:**",
    "build:css": "sass -I node_modules sass/styles.scss dist/styles.css --style compressed",
    "build:css:components": "sass -I node_modules ./sass/entrypoints:./dist --style compressed",
    "minify:css:components": "find ./dist/ -name '*.css' | while read f; do postcss ${f} -o ./${f%.css}.css; done;",
    "build:js": "node scripts/js.js ./node_modules ./js/index.js ./dist/bundle.js",
    "minify:js": "terser -c -m --log-level info ./dist/bundle.js -o ./dist/bundle.js",
    "build:js:components": "ls -A1 js/components/ | while read f; do node scripts/js.js ./node_modules ./js/components/${f%.*}/index.js ./dist/${f%/}.js; done;",
    "minify:js:components": "find ./dist/ -name '*.js' | while read f; do terser -c -m --log-level info ${f} -o ./${f%.js}.js; done;",
    "watch:css": "chokidar '**/*.scss' -c 'npm run build:css:components'",
    "watch:js": "chokidar '**/*.js' -c 'npm run build:js:components'",
    "watch": "chokidar 'js/**/*.js' 'sass/**/*.scss' -c 'npm run build'",
    "fractal:watch": "fractal start --sync",
    "fractal:build": "fractal build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bucks-francisco-romero/bnu-bundle.git"
  },
  "author": "Stuart Wilson <s.wilson@catchdigital.com>",
  "contributors": [
    "Alberto Contreras <a.contreras@catchdigital.com>",
    "George Phillips <g.phillips@catchdigital.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/cli": "^7.12.8",
    "@babel/core": "^7.12.9",
    "@popperjs/core": "^2.9.2",
    "autoprefixer": "^10.4.2",
    "babelify": "^10.0.0",
    "bootstrap": "^5.0.1",
    "browserify": "^17.0.0",
    "log-timestamp": "^0.3.0",
    "node.normalize.scss": "^3.0.3",
    "normalize-scss": "^8.0.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.39",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.3.3",
    "sass": "^1.32.8"
  },
  "engines": {
    "node": "^20.0.0"
  },
  "devDependencies": {
    "@babel/node": "^7.25.0",
    "@babel/preset-env": "^7.25.4",
    "@frctl/fractal": "^1.3.0",
    "@frctl/mandelbrot": "^1.6.0",
    "axios": ">=0.28.0",
    "body-parser": ">=1.20.3",
    "braces": ">=3.0.3",
    "cookie": ">=0.7.0",
    "chokidar": "^3.4.3",
    "chokidar-cli": "^3.0.0",
    "cross-spawn": ">=7.0.5",
    "cssnano": "^7.0.6",
    "elliptic": ">=6.6.0",
    "express": ">=4.20.0",
    "got": ">=11.8.5",
    "jasmine": "^5.2.0",
    "jasmine-core": "^5.2.0",
    "jsdom": "^16.4.0",
    "lodash": ">=4.17.21",
    "nanoid": ">=3.3.8",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-preset-env": "^10.1.3",
    "serve-static": ">=1.16.0",
    "terser": "^5.37.0"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ]
        }
      ]
    ]
  },
  "bugs": {
    "url": "https://github.com/bucks-francisco-romero/bnu-bundle/issues"
  },
  "homepage": "https://github.com/bucks-francisco-romero/bnu-bundle#readme"
}
